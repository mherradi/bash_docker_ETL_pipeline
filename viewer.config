server {
  listen 80;
  root /usr/share/nginx/viewer;
  index index.html;

  # The page reads this folder. "autoindex ... json" lets index.html list every file in it.
  location /result/ {
    alias /usr/share/nginx/result/;
    autoindex on;
    autoindex_format json;
    add_header Cache-Control "no-store";
  }

  location /output/ {
    alias /usr/share/nginx/output/;
    autoindex on;
    autoindex_format json;
    add_header Cache-Control "no-store";
  }
}
